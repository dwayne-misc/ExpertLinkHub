# Google Sheets Configuration
# Required: Google Sheets Spreadsheet ID
SPREADSHEET_ID=1kRomUELKC_iLfW5OQFG-78mc8r8jQ1qujDhINhdygEg

# For Vercel/Production Deployment:
# Add your Google Service Account JSON credentials as a single-line string
